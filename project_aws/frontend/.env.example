# Copy to .env.local (dev) or .env.production (build) and set when the API is on another origin.
# Empty = same origin (Vite proxy in dev, CloudFront /api/* behavior in Phase 6).
#
# Phase 2 (single EC2):   VITE_API_BASE=http://<ec2-public-ip>:8080
# Phase 3/4 (ALB):        VITE_API_BASE=http://<alb-dns-name>
# Phase 6 (CloudFront):   VITE_API_BASE=
VITE_API_BASE=
